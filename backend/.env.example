# Django Environment Configuration Example

SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Email settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=QuBook <example@gmail.com>

# Cloudflare R2 / S3 Storage Settings
USE_R2=False
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_cloudflare_r2_bucket_name
AWS_S3_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.qubook.in
AWS_QUERYSTRING_AUTH=False
